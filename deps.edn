{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        org.jline/jline {:mvn/version "4.4.8"}  ;; slower than individual imports?
        ;org.jline/jline-reader {:mvn/version "4.4.8"}
        ;org.jline/jline-terminal {:mvn/version "4.4.8"}
        ;org.jline/jline-terminal-jansi {:mvn/version "3.30.17"}
        cljfmt/cljfmt {:mvn/version "0.9.2"}
        rewrite-clj/rewrite-clj {:mvn/version "1.3.59"}
        nrepl/nrepl               {:mvn/version "1.8.0"}
        compliment/compliment {:mvn/version "0.8.2"}}
 :aliases {:repl/balance {:extra-paths ["repl"]
                          :extra-deps  {nrepl/nrepl               {:mvn/version "1.8.0"}
                                        cider/cider-nrepl         {:mvn/version "0.63.1"}
                                        clj-commons/pomegranate   {:mvn/version "1.3.27"}
                                        org.clojure/tools.deps.alpha ; add-lib3 branch
                                        {:git/url "https://github.com/clojure/tools.deps.alpha"
                                         :sha     "5b8909bdb072d66c9f643bae50cd2878a0f694c2"}}
                          :main-opts   ["-m" "nrepl.cmdline"
                                        "--middleware" "[cider.nrepl/cider-middleware]"
                                        "-i"
                                        "-f" "repl-balance.main/-main"]}
           :test         {:extra-paths ["test"]
                          :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                                        ring/ring-spec      {:mvn/version "0.0.4"}
                                        ; silence slf4j log warnings during testing
                                        org.slf4j/slf4j-nop {:mvn/version "2.0.20"}}
                          :main-opts   ["-m" "kaocha.runner"]}
           ;; tools.build `build.clj` built script
           :build
           {:replace-paths ["."]
            :extra-deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                         slipset/deps-deploy {:mvn/version "0.2.5"}}
            :ns-default build}}}
